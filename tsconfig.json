{
  "compilerOptions": {
    "lib": ["ES2020"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "target": "ES2020",
    "types": ["mocha"],
    "outDir": "dist"
  },
  "include": [
    "index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "test/**/*.js",
    "test/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
