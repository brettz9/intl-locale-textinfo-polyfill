{
  "name": "intl-locale-textinfo-polyfill",
  "version": "3.0.1",
  "description": "Library will help you to detect if the locale is right-to-left language.",
  "main": "./index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    },
    "./lib/Locale.js": {
      "types": "./dist/lib/Locale.d.ts",
      "default": "./lib/Locale.js"
    },
    "./lib/polyfill.js": {
      "types": "./lib/polyfill.d.ts",
      "default": "./lib/polyfill.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm tsc-prod && pnpm attw",
    "attw": "attw --pack . --profile esm-only node16",
    "tsc-prod": "tsc -p tsconfig-prod.json",
    "tsc": "tsc",
    "open": "open http://localhost:8087/test",
    "start": "static -p 8087",
    "lint": "eslint .",
    "pretest": "npm run lint && npm run tsc",
    "mocha": "mocha --require test/node-bootstrap.js test/**/*.js test/*.js",
    "c8": "c8 npm run mocha",
    "test": "npm run c8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brettz9/intl-locale-textinfo-polyfill.git"
  },
  "keywords": [
    "intl-locale",
    "intl",
    "rtl-detect",
    "locale direction",
    "locale dir",
    "locale",
    "intl direction",
    "intl dir",
    "intl",
    "right-to-left",
    "left-to-right",
    "rtl",
    "ltr",
    "intl-lang"
  ],
  "author": "Brett Zamir",
  "contributors": [
    "Shadi Abu Hilal <shadiabuhilal@gmail.com> (http://github.com/shadiabuhilal)"
  ],
  "homepage": "https://github.com/brettz9/intl-locale-textinfo-polyfill",
  "bugs": "https://github.com/brettz9/intl-locale-textinfo-polyfill/issues",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@node-static/node-static": "^0.9.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "mocha": "^12.0.0",
    "typescript": "^7.0.2"
  }
}
